{
  "name": "local-ai",
  "version": "2.0.0",
  "description": "Private, fully offline local AI ChatGPT/Claude desktop app for Windows",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "build:vite": "vite build",
    "build:electron": "node scripts/build-electron.js",
    "build": "npm run build:vite && npm run build:electron",
    "start": "electron .",
    "dev:electron": "concurrently -k \"vite\" \"cross-env WAIT_ON_WEB=1 node scripts/dev.js\"",
    "test": "node scripts/test-unit.js",
    "test:e2e": "node scripts/run-e2e.js",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.electron.json --noEmit",
    "package": "npm run build && electron-builder --win"
  },
  "keywords": [
    "ollama",
    "local-ai",
    "electron",
    "react",
    "private-chat"
  ],
  "author": "LocalAI",
  "license": "MIT",
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "mammoth": "^1.9.1",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.3",
    "read-excel-file": "^9.3.14",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "sql.js": "^1.12.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/pdf-parse": "^1.1.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^35.0.0",
    "electron-builder": "^26.18.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vite": "^6.2.1"
  },
  "build": {
    "appId": "com.localai.desktop",
    "productName": "LocalAI",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      "dist-renderer/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  }
}
